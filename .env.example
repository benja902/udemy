NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings. Use the service role key only on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional shared secret for POST /api/check from external cron services.
MONITOR_SECRET=

# Optional Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Browser automation.
PLAYWRIGHT_HEADLESS=true
UDEMY_LOCALE=es_ES
